	tft_fill_round_rect(12, 26, 296, 188, 6, 0x1082)
	tft_draw_round_rect(12, 26, 296, 188, 6, CYAN)
	tft_fill_round_rect(16, 30, 288, 22, 4, NAVY)

	tft_set_text_datum(MC_DATUM)
	tft_set_text_color(WHITE, NAVY)
	tft_draw_string("CORNER COORDINATES", 160, 41, 2)

	// 2x2 Grid of Editable Coordinate Boxes
	// Top-left: X Min (20, 58, 134, 42)
	tft_fill_round_rect(20, 58, 134, 42, 4, 0x18E3)
	tft_draw_round_rect(20, 58, 134, 42, 4, CYAN)
	tft_set_text_datum(TL_DATUM)
	tft_set_text_color(LIGHTGREY, 0x18E3)
	tft_draw_string("X Min (Left):", 26, 62, 1)
	tft_set_text_color(YELLOW, 0x18E3)
	tft_draw_string(float_to_str(xMin), 26, 76, 2)

	// Top-right: X Max (166, 58, 134, 42)
	tft_fill_round_rect(166, 58, 134, 42, 4, 0x18E3)
	tft_draw_round_rect(166, 58, 134, 42, 4, CYAN)
	tft_set_text_color(LIGHTGREY, 0x18E3)
	tft_draw_string("X Max (Right):", 172, 62, 1)
	tft_set_text_color(YELLOW, 0x18E3)
	tft_draw_string(float_to_str(xMax), 172, 76, 2)

	// Bottom-left: Y Min (20, 108, 134, 42)
	tft_fill_round_rect(20, 108, 134, 42, 4, 0x18E3)
	tft_draw_round_rect(20, 108, 134, 42, 4, CYAN)
	tft_set_text_color(LIGHTGREY, 0x18E3)
	tft_draw_string("Y Min (Bottom):", 26, 112, 1)
	tft_set_text_color(YELLOW, 0x18E3)
	tft_draw_string(float_to_str(yMin), 26, 126, 2)

	// Bottom-right: Y Max (166, 108, 134, 42)
	tft_fill_round_rect(166, 108, 134, 42, 4, 0x18E3)
	tft_draw_round_rect(166, 108, 134, 42, 4, CYAN)
	tft_set_text_color(LIGHTGREY, 0x18E3)
	tft_draw_string("Y Max (Top):", 172, 112, 1)
	tft_set_text_color(YELLOW, 0x18E3)
	tft_draw_string(float_to_str(yMax), 172, 126, 2)

	// Action buttons at bottom of modal (y = 162..198)
	tft_set_text_datum(MC_DATUM)

	// [-10..10] Reset standard window
	tft_fill_round_rect(20, 164, 84, 34, 4, 0x2945)
	tft_draw_round_rect(20, 164, 84, 34, 4, CYAN)
	tft_set_text_color(WHITE, 0x2945)
	tft_draw_string("-10..10", 62, 181, 2)

	// [AUTO Y] Fit Y to curve
	tft_fill_round_rect(114, 164, 84, 34, 4, PURPLE)
	tft_draw_round_rect(114, 164, 84, 34, 4, WHITE)
	tft_set_text_color(WHITE, PURPLE)
	tft_draw_string("AUTO Y", 156, 181, 2)

	// [DONE]
	tft_fill_round_rect(208, 164, 92, 34, 4, 0x03E0)
	tft_draw_round_rect(208, 164, 92, 34, 4, GREEN)
	tft_set_text_color(WHITE, 0x03E0)
	tft_draw_string("DONE", 254, 181, 2)

	tft_set_text_datum(TL_DATUM)
}

func promptFloatCoord(title string, curVal float32) (bool, float32) {
	copyFloatToCStr(curVal, &kbBuf[0], 32)
	if os_prompt_keyboard(title, &kbBuf[0], 31, false) == 1 {
		ok, v := parseFloatFromCStr(&kbBuf[0])
		if ok {
			return true, v
		}
	}
	return false, curVal
}

func runBoundsModal() {
	drawBoundsModal()
	for {
		if os_serial_available() > 0 {
			ch := os_serial_read()
			if ch == 'q' || ch == 'Q' || ch == 3 {
				os_exit(0)
			}
		}
		clicked, tx, ty := os_read_click()
		if clicked {
			if IsExitWedge(tx, ty) {
				os_exit(0)
			}
			if ty >= 58 && ty <= 100 {
				if tx >= 20 && tx <= 154 {
					ok, v := promptFloatCoord("X Min (Left):", xMin)
					if ok && v < xMax {
						xMin = v
					}
					drawBoundsModal()
				} else if tx >= 166 && tx <= 300 {
					ok, v := promptFloatCoord("X Max (Right):", xMax)
					if ok && v > xMin {
						xMax = v
					}
					drawBoundsModal()
				}
			} else if ty >= 108 && ty <= 150 {
				if tx >= 20 && tx <= 154 {
					ok, v := promptFloatCoord("Y Min (Bottom):", yMin)
					if ok && v < yMax {
						yMin = v
					}
					drawBoundsModal()
				} else if tx >= 166 && tx <= 300 {
					ok, v := promptFloatCoord("Y Max (Top):", yMax)
					if ok && v > yMin {
						yMax = v
					}
					drawBoundsModal()
				}
			} else if ty >= 164 && ty <= 198 {
				if tx >= 20 && tx <= 104 {
					xMin = -10.0
					xMax = 10.0
					yMin = -10.0
					yMax = 10.0
					drawBoundsModal()
				} else if tx >= 114 && tx <= 198 {
					autoFitY()
					drawBoundsModal()
				} else if tx >= 208 && tx <= 300 {
					traceActive = 0
					drawGraphScreen()
					return
				}
			} else if tx < 12 || tx > 308 || ty < 26 || ty > 214 {
				traceActive = 0
				drawGraphScreen()
				return
			}
		}
		os_delay_ms(20)
	}
}

func runGraphMenu() {
	s := CornerSize()
	menuY := s
	if menuY < 24 {
		menuY = 24
	}
	menuW := 148
	menuX := 318 - menuW
	menuH := 118

	tft_fill_round_rect(menuX, menuY, menuW, menuH, 5, 0x10A2)
	tft_draw_round_rect(menuX, menuY, menuW, menuH, 5, CYAN)

	tft_set_text_datum(MC_DATUM)
	for i := 0; i < 4; i++ {
		iy := menuY + 4 + i*28
		tft_fill_round_rect(menuX+4, iy, menuW-8, 24, 4, 0x18E3)
		tft_draw_round_rect(menuX+4, iy, menuW-8, 24, 4, CYAN)
		tft_set_text_color(WHITE, 0x18E3)
		if i == 0 {
			tft_draw_string("Enter f(x)", menuX+menuW/2, iy+12, 2)
		} else if i == 1 {
			tft_draw_string("Corner Bounds", menuX+menuW/2, iy+12, 2)
		} else if i == 2 {
			tft_draw_string("Auto-Fit Y", menuX+menuW/2, iy+12, 2)
		} else {
			tft_draw_string("Reset [-5..5]", menuX+menuW/2, iy+12, 2)
		}
	}
	tft_set_text_datum(TL_DATUM)

	for {
		if os_serial_available() > 0 {
			ch := os_serial_read()
			if ch == 'q' || ch == 'Q' || ch == 3 {
				os_exit(0)
			}
		}
		clicked, cx, cy := os_read_click()
		if clicked {
			if cx >= menuX && cx <= menuX+menuW && cy >= menuY+4 && cy < menuY+menuH-2 {
				item := (cy - (menuY + 4)) / 28
				if item == 0 {
					promptFunctionExpr()
					return
				} else if item == 1 {
					runBoundsModal()
					return
				} else if item == 2 {
					autoFitY()
				} else if item == 3 {
					xMin = -5.0
					xMax = 5.0
					yMin = -5.0
					yMax = 5.0
					traceActive = 0
				}
			}
			drawGraphScreen()
			return
		}
		os_delay_ms(20)
	}
}

func main() {
	setCStrLiteral(&exprBuf[0], "x^3 - 3*x", 64)
	compileExpr()
	drawGraphScreen()

	for {
		if os_serial_available() > 0 {
			ch := os_serial_read()
			if ch == 'q' || ch == 'Q' || ch == 3 {
				os_exit(0)
			}
		}

		clicked, tx, ty := os_read_click()
		if clicked {
			if IsExitWedge(tx, ty) {
				os_exit(0)
			} else if IsMenuWedge(tx, ty) {
				runGraphMenu()
			} else if ty < 24 {
				// Top formula bar tapped -> prompt for f(x)
				promptFunctionExpr()
			} else if ty >= BAR_Y0 {
				// Bottom control bar buttons:
				if tx <= 46 {
					promptFunctionExpr()
				} else if tx >= 48 && tx <= 83 {
					zoomViewport(0.5)
					drawGraphScreen()
				} else if tx >= 85 && tx <= 120 {
					zoomViewport(2.0)
					drawGraphScreen()
				} else if tx >= 122 && tx <= 155 {
					panViewport(-0.25, 0.0)
					drawGraphScreen()
				} else if tx >= 157 && tx <= 190 {
					panViewport(0.25, 0.0)
					drawGraphScreen()
				} else if tx >= 192 && tx <= 225 {
					panViewport(0.0, 0.25)
					drawGraphScreen()
				} else if tx >= 227 && tx <= 260 {
					panViewport(0.0, -0.25)
					drawGraphScreen()
				} else if tx >= 262 {
					runBoundsModal()
				}
			} else if ty >= PLOT_Y0 && ty < PLOT_Y0+PLOT_H {
				// Tapped inside graph viewport -> evaluate trace point at x
				traceActive = 1
				traceX = xMin + (float32(tx)*(xMax-xMin))/float32(PLOT_W-1)
				ok, yv := evalF(traceX)
				if ok {
					traceValid = 1
					traceY = yv
				} else {
					traceValid = 0
				}
				drawGraphViewport()
			}
		}
		os_delay_ms(20)
	}
}
