func drawGraphViewport() {
	tft_fill_rect(PLOT_X0, PLOT_Y0, PLOT_W, PLOT_H, BLACK)

	// 1. Subtle coordinate grid lines
	stepX := chooseGridStep(xMax - xMin)
	firstGridX := floor(xMin/stepX) * stepX
	gx := firstGridX
	steps := 0
	for gx <= xMax && steps < 24 {
		if gx >= xMin {
			sx := worldToScreenX(gx)
			if sx >= 0 && sx < PLOT_W {
				tft_draw_fast_v_line(sx, PLOT_Y0, PLOT_H, 0x10A3)
			}
		}
		gx = gx + stepX
		steps++
	}

	stepY := chooseGridStep(yMax - yMin)
	firstGridY := floor(yMin/stepY) * stepY
	gy := firstGridY
	steps = 0
	for gy <= yMax && steps < 24 {
		if gy >= yMin {
			sy := worldToScreenY(gy)
			if sy >= PLOT_Y0 && sy < PLOT_Y0+PLOT_H {
				tft_draw_fast_h_line(0, sy, PLOT_W, 0x10A3)
			}
		}
		gy = gy + stepY
		steps++
	}

	// 2. X=0 and Y=0 Axes + Tick Marks
	if xMin <= 0.0 && xMax >= 0.0 {
		axX := worldToScreenX(0.0)
		if axX >= 0 && axX < PLOT_W {
			tft_draw_fast_v_line(axX, PLOT_Y0, PLOT_H, 0x4A69)
			gy = firstGridY
			steps = 0
			for gy <= yMax && steps < 24 {
				sy := worldToScreenY(gy)
				if sy >= PLOT_Y0 && sy < PLOT_Y0+PLOT_H {
					tft_draw_fast_h_line(axX-2, sy, 5, CYAN)
				}
				gy = gy + stepY
				steps++
			}
		}
	}
	if yMin <= 0.0 && yMax >= 0.0 {
		axY := worldToScreenY(0.0)
		if axY >= PLOT_Y0 && axY < PLOT_Y0+PLOT_H {
			tft_draw_fast_h_line(0, axY, PLOT_W, 0x4A69)
			gx = firstGridX
			steps = 0
			for gx <= xMax && steps < 24 {
				sx := worldToScreenX(gx)
				if sx >= 0 && sx < PLOT_W {
					tft_draw_fast_v_line(sx, axY-2, 5, CYAN)
				}
				gx = gx + stepX
				steps++
			}
		}
	}

	// 3. Plot y = f(x) across all 320 pixel columns
	if parseErr != 0 {
		tft_set_text_datum(MC_DATUM)
		tft_set_text_color(RED, BLACK)
		tft_draw_string("Syntax error in f(x)", 160, PLOT_Y0+PLOT_H/2, 2)
		tft_set_text_datum(TL_DATUM)
	} else {
		spanX := xMax - xMin
		prevValid := 0
		prevSy := 0
		for px := 0; px < PLOT_W; px++ {
			xv := xMin + (float32(px)*spanX)/float32(PLOT_W-1)
			ok, yv := evalF(xv)
			if ok {
				sy := worldToScreenY(yv)
				inView := sy >= PLOT_Y0-PLOT_H && sy < PLOT_Y0+2*PLOT_H
				if inView {
					if prevValid != 0 && abs(sy-prevSy) < PLOT_H {
						// Clip line segment vertically to [PLOT_Y0 .. PLOT_Y0+PLOT_H-1]
						y0 := prevSy
						y1 := sy
						if y0 > y1 {
							tmp := y0
							y0 = y1
							y1 = tmp
						}
						if y1 >= PLOT_Y0 && y0 < PLOT_Y0+PLOT_H {
							if y0 < PLOT_Y0 {
								y0 = PLOT_Y0
							}
							if y1 >= PLOT_Y0+PLOT_H {
								y1 = PLOT_Y0 + PLOT_H - 1
							}
							tft_draw_fast_v_line(px, y0, y1-y0+1, YELLOW)
						}
					} else if sy >= PLOT_Y0 && sy < PLOT_Y0+PLOT_H {
						tft_draw_fast_v_line(px, sy, 2, YELLOW)
					}
					prevSy = sy
					prevValid = 1
				} else {
					prevValid = 0
				}
			} else {
				prevValid = 0
			}
		}
	}

	// 4. Corner Coordinate Overlays
	tft_set_text_datum(TL_DATUM)
	tft_set_text_color(LIGHTGREY, BLACK)
	tft_draw_string(float_to_str(yMax), 4, PLOT_Y0+3, 1)
	tft_set_text_datum(BL_DATUM)
	tft_draw_string(float_to_str(xMin), 4, PLOT_Y0+PLOT_H-3, 1)
	tft_set_text_datum(BR_DATUM)
	tft_draw_string(float_to_str(xMax), 316, PLOT_Y0+PLOT_H-3, 1)
	tft_set_text_datum(TR_DATUM)
	tft_draw_string(float_to_str(yMin), 316, PLOT_Y0+PLOT_H-12, 1)

	// 5. Optional Trace Crosshair & Readout
	if traceActive != 0 {
		tsx := worldToScreenX(traceX)
		if tsx >= 0 && tsx < PLOT_W {
			tft_draw_fast_v_line(tsx, PLOT_Y0, PLOT_H, 0x39E7)
		}
		if traceValid != 0 {
			tsy := worldToScreenY(traceY)
			if tsy >= PLOT_Y0 && tsy < PLOT_Y0+PLOT_H {
				tft_fill_circle(tsx, tsy, 3, GREEN)
			}
		}
		tft_set_text_datum(TC_DATUM)
		tft_set_text_color(GREEN, BLACK)
		tft_draw_string(float_to_str(traceX), 130, PLOT_Y0+3, 1)
		if traceValid != 0 {
			tft_set_text_color(YELLOW, BLACK)
			tft_draw_string(float_to_str(traceY), 195, PLOT_Y0+3, 1)
		}
	}
	tft_set_text_datum(TL_DATUM)
}

func drawGraphScreen() {
	drawTopBar()
	drawGraphViewport()
	drawBottomControlBar()
}

// ============================================================================
// Function Prompt & Corner Coordinates Modal
// ============================================================================
func promptFunctionExpr() {
	memcpy(int(&kbBuf[0]), int(&exprBuf[0]), 64)
	res := os_prompt_keyboard("f(x) = (e.g. x^3-3x, sin(x))", &kbBuf[0], 63, false)
	if res == 1 && kbBuf[0] != 0 {
		memcpy(int(&exprBuf[0]), int(&kbBuf[0]), 64)
		compileExpr()
		traceActive = 0
	}
	drawGraphScreen()
}

