// ============================================================================
// Wind Chimes (wind.lgolf) for Lakatos OS on ESP32-2432S028R (CYD)
// ============================================================================
// Plays gentle sine-wave wind chime tones with:
//   - Scale 0: E Min Pentatonic (Just)  -- E3..E6 (1/1, 6/5, 4/3, 3/2, 9/5)
//   - Scale 1: G Maj Pentatonic (Just)  -- G3..G6 (1/1, 9/8, 5/4, 3/2, 5/3)
//   - Scale 2: Diminished (Even)        -- G3..G6 (minor thirds: G, Bb, Db, E)
// Features an Attack/Decay/Sustain/Release (ADSR) envelope holding each tone
// > 3 seconds and a Poisson arrival process averaging 2.0 seconds.
// ============================================================================

package main

import "wedge"

const (
	MAX_NOTES  = 16
	NUM_VOICES = 12

	SCALE_E_MIN_PENT = 0
	SCALE_G_MAJ_PENT = 1
	SCALE_DIMINISHED = 2

	// ADSR envelope stage identifiers
	ENV_IDLE    = 0
	ENV_ATTACK  = 1
	ENV_DECAY   = 2
	ENV_SUSTAIN = 3
	ENV_RELEASE = 4

	// ADSR stage durations in milliseconds:
	// Attack (0.12s) + Decay (0.88s) + Sustain (2.20s) = 3.20s held before 2.00s Release (5.20s total)
	ATTACK_MS  = 120
	DECAY_MS   = 880
	SUSTAIN_MS = 2200
	RELEASE_MS = 2000

	// Sustain level as permille of peak (600 / 1000 = 60%)
	SUSTAIN_PERMILLE = 600

	// Theme RGB565 colors
	COL_BG         = 0x0842
	COL_HEADER     = 0x10A4
	COL_PANEL      = 0x1083
	COL_WOOD       = 0x6A22
	COL_WOOD_HI    = 0x9B65
	COL_STRING     = 0x52AA
	COL_TUBE_IDLE  = 0x3A09
	COL_TUBE_RIM   = 0x5B0D
	COL_TRACK_BG   = 0x0821
	COL_BTN_BG     = 0x1926
	COL_BTN_ACTIVE = 0x03EF
	COL_BTN_BORDER = 0x4A69
)

var scaleMode int = 0
var numNotes int = 16
var menuOpen int = 0

var noteSteps [16]int
var noteHz [16]int
var tubeLens [16]int
var noteScaleWeight [16]int

// Volume curve for VOL slider 0 (silent) .. 11 (overmodulated), default 6 (somewhat soft)
var volPeakTable [12]int

// Polyphonic voice pool (12 channels mapped to hardware channels 0..11)
var vNote [12]int
var vState [12]int
var vStageMs [12]int
var vLevel [12]int // 0..1000 permille envelope level
var vStartLv [12]int
var vLastVol [12]int

// Per-note visual state (0..1000 envelope level and last drawn quantized bar)
var noteVisLv [16]int
var prevTubeGlow [16]int
var prevEnvBar [16]int

var volLevel int = 6       // 0..11, default 6
var speedTenths int = 20   // 5..50 (0.5s .. 5.0s in 0.5s steps), default 20 (2.0s)
var meanArrivalMs int = 2000
var nextStrikeAtMs int = 0
var lastNoteStruck int = -1
var totalStrikes int = 0
var prevActiveVoices int = -1
var prevLastNote int = -2

func silenceAllVoices() {
	for c := 0; c < NUM_VOICES; c++ {
		vNote[c] = -1
		vState[c] = ENV_IDLE
		vStageMs[c] = 0
		vLevel[c] = 0
		vStartLv[c] = 0
		vLastVol[c] = 0
		audio_set_voice(c, WAVE_NONE, 0, 0, 0)
	}
}

func loadScale(mode int) {
	scaleMode = mode
	lastNoteStruck = -1
	prevActiveVoices = -1
	prevLastNote = -2

	if mode == SCALE_E_MIN_PENT {
		numNotes = 16
		// Just Intonation E Minor Pentatonic (1/1, 6/5, 4/3, 3/2, 9/5) from E3 (165 Hz) to E6 (1320 Hz)
		noteSteps[0] = 177167
		noteHz[0] = 165
		noteSteps[1] = 212601
		noteHz[1] = 198
		noteSteps[2] = 236223
		noteHz[2] = 220
		noteSteps[3] = 265751
		noteHz[3] = 248
		noteSteps[4] = 318901
		noteHz[4] = 297

		noteSteps[5] = 354335
		noteHz[5] = 330
		noteSteps[6] = 425202
		noteHz[6] = 396
		noteSteps[7] = 472446
		noteHz[7] = 440
		noteSteps[8] = 531502
		noteHz[8] = 495
		noteSteps[9] = 637803
		noteHz[9] = 594

		noteSteps[10] = 708670
		noteHz[10] = 660
		noteSteps[11] = 850404
		noteHz[11] = 792
		noteSteps[12] = 944893
		noteHz[12] = 880
		noteSteps[13] = 1063004
		noteHz[13] = 990
		noteSteps[14] = 1275605
		noteHz[14] = 1188
		noteSteps[15] = 1417339
		noteHz[15] = 1320
	} else if mode == SCALE_G_MAJ_PENT {
		numNotes = 16
		// Just Intonation G Major Pentatonic (1/1, 9/8, 5/4, 3/2, 5/3) from G3 (198 Hz) to G6 (1584 Hz)
		noteSteps[0] = 212601
		noteHz[0] = 198
		noteSteps[1] = 239176
		noteHz[1] = 223
		noteSteps[2] = 265751
		noteHz[2] = 248
		noteSteps[3] = 318901
		noteHz[3] = 297
		noteSteps[4] = 354335
		noteHz[4] = 330

		noteSteps[5] = 425202
		noteHz[5] = 396
		noteSteps[6] = 478352
		noteHz[6] = 446
		noteSteps[7] = 531502
		noteHz[7] = 495
		noteSteps[8] = 637803
		noteHz[8] = 594
		noteSteps[9] = 708670
		noteHz[9] = 660

		noteSteps[10] = 850404
		noteHz[10] = 792
		noteSteps[11] = 956704
		noteHz[11] = 891
		noteSteps[12] = 1063004
		noteHz[12] = 990
		noteSteps[13] = 1275605
		noteHz[13] = 1188
		noteSteps[14] = 1417339
		noteHz[14] = 1320
		noteSteps[15] = 1700808
		noteHz[15] = 1584
	} else {
		numNotes = 13
		// Even-Tempered Diminished 7th (G, Bb, Db, E -- minor 3rds) from G3 (196 Hz) to G6 (1568 Hz)
		noteSteps[0] = 210453
		noteHz[0] = 196
		noteSteps[1] = 250269
		noteHz[1] = 233
		noteSteps[2] = 297622
		noteHz[2] = 277
		noteSteps[3] = 353935
		noteHz[3] = 330

		noteSteps[4] = 420906
		noteHz[4] = 392
		noteSteps[5] = 500539
		noteHz[5] = 466
		noteSteps[6] = 595245
		noteHz[6] = 554
		noteSteps[7] = 707870
		noteHz[7] = 659

		noteSteps[8] = 841812
		noteHz[8] = 784
		noteSteps[9] = 1001078
		noteHz[9] = 932
		noteSteps[10] = 1190490
		noteHz[10] = 1109
		noteSteps[11] = 1415740
		noteHz[11] = 1319
		noteSteps[12] = 1683624
		noteHz[12] = 1568
	}

	for i := 0; i < MAX_NOTES; i++ {
		if numNotes == 13 {
			tubeLens[i] = 92 - i*5
			noteScaleWeight[i] = 100 - (i*38)/12
		} else {
			tubeLens[i] = 92 - i*4
			noteScaleWeight[i] = 100 - (i*38)/15
		}
		noteVisLv[i] = 0
		prevTubeGlow[i] = -1
		prevEnvBar[i] = -1
	}
}

func initScaleTables() {
	volLevel = 6
	speedTenths = 20
	meanArrivalMs = 2000
	scaleMode = SCALE_E_MIN_PENT
	menuOpen = 0
	totalStrikes = 0

	// Peak hardware voice volume for VOL 0..11:
	// 0 = silent, 6 = soft default (22), 9 = full clean (58), 10..11 = overmodulated (95..155)
	volPeakTable[0] = 0
	volPeakTable[1] = 3
	volPeakTable[2] = 5
	volPeakTable[3] = 8
	volPeakTable[4] = 12
	volPeakTable[5] = 16
	volPeakTable[6] = 22
	volPeakTable[7] = 30
	volPeakTable[8] = 42
	volPeakTable[9] = 58
	volPeakTable[10] = 95
	volPeakTable[11] = 155

	for c := 0; c < NUM_VOICES; c++ {
		vNote[c] = -1
		vState[c] = ENV_IDLE
		vStageMs[c] = 0
		vLevel[c] = 0
		vStartLv[c] = 0
		vLastVol[c] = 0
	}

	loadScale(SCALE_E_MIN_PENT)
}

func scaleTitleStr(mode int) string {
	if mode == SCALE_E_MIN_PENT {
		return "E Min Pentatonic (Just)"
	}
	if mode == SCALE_G_MAJ_PENT {
		return "G Maj Pentatonic (Just)"
	}
	return "Diminished"
}

func scaleIdleSummaryStr() string {
	if scaleMode == SCALE_E_MIN_PENT {
		return "Scale: E G A B D  (1/1 6/5 4/3 3/2 9/5)"
	}
	if scaleMode == SCALE_G_MAJ_PENT {
		return "Scale: G A B D E  (1/1 9/8 5/4 3/2 5/3)"
	}
	return "Scale: G Bb Db E  (Even Minor 3rds)"
}

