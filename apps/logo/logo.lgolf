// P-Code / Token Types for Logo Compiler & Interpreter
// ============================================================================
const MAX_TOKENS = 768
const MAX_IDENT_POOL = 2048

const TOK_EOF = 0
const TOK_NUM = 1     // float32 literal in tokNum[i]
const TOK_WORD = 2    // uppercase identifier in identPool at tokVal[i]
const TOK_VAR = 3     // :VAR reference in identPool at tokVal[i]
const TOK_QUOTE = 4   // "VAR quoted word in identPool at tokVal[i]
const TOK_LBRACK = 5  // '[' with matching ']' index in tokVal[i]
const TOK_RBRACK = 6  // ']' with matching '[' index in tokVal[i]
const TOK_OP = 7      // operator char ('+', '-', '*', '/', '%', '=', '<', '>', '!', 'L'<=, 'G'>=)
const TOK_LPAREN = 8  // '('
const TOK_RPAREN = 9  // ')'

