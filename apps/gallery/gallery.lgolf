// gallery: Slideshow viewer for /net/pix/ on Lakatos OS (320x240)
// Remembers up to 500 .jpg basenames (<= 8 bytes each without the .jpg extension),
// shuffles them using the ESP32 hardware TRNG (os_rand), and displays each image
// centered on the 320x240 screen for 10 seconds using Core 0 background prefetching.
//
// Ambient Mode Rule:
//   If the app has been running for over 60 seconds and has received no touch clicks
//   in the last 60 seconds, neither the NW Exit X nor the NE Menu Wedge is shown
//   until there is a touch click again.
package main

import "wedge"

const (
	BUF_MAX         = 65536 // 64 KB reusable Core 0 prefetch & decode buffer
	MAX_SCAN        = 700   // 700 * 88 = 61,600 B fits inside 64 KB imgBuf during scanCatalog()
	MAX_IMAGES      = 500   // Up to 500 .jpg basenames remembered
	NAME_STRIDE     = 8     // Up to 8 bytes per basename (without ".jpg")
	ENTRY_SIZE      = 88    // sizeof(LakatosFsEntry): name[64], size(8), mtime(8), isDir(1), pad(7)
	ENTRY_ISDIR     = 80
	POLL_STEP_MS    = 40
	AMBIENT_HIDE_MS = 60000 // Hide Exit X and Menu Wedge after 60s running & 60s without touch clicks
)

var (
	imgBuf   [BUF_MAX]byte
	imgNames [4000]byte // MAX_IMAGES (500) * NAME_STRIDE (8)
	imgCount int

	pathBuf     [32]byte // "/net/pix/" (9) + basename (<=8) + ".jpg" (4) + NUL
	cfgBuf      [16]byte // "/flash/etc/gallery.cfg" ASCII seconds buffer
	retryMsgBuf [36]byte // "Retrying in X seconds..." countdown buffer
	prefetchIdx int

	slideStopIdx int = 1  // Default stop index 1 -> 12 seconds per photo
	slideSec     int = 12 // Seconds per photo (5, 12, 30, 60, 300, 3600)

	appStartMs       int = 0
	lastTouchClickMs int = 0
	lastSlideClickMs int = 0
	wedgesVisible    int = 0
)

func stopSeconds(idx int) int {
	if idx <= 0 {
		return 5
	}
	if idx == 1 {
		return 12
	}
	if idx == 2 {
		return 30
	}
	if idx == 3 {
		return 60
	}
	if idx == 4 {
		return 300
	}
	return 3600
}

func stopLabel(idx int) string {
	if idx <= 0 {
		return "5"
	}
	if idx == 1 {
		return "12"
	}
	if idx == 2 {
		return "30"
	}
	if idx == 3 {
		return "60"
	}
	if idx == 4 {
		return "300"
	}
	return "3600"
}

func stopBadgeLabel(idx int) string {
	if idx <= 0 {
		return "5 sec"
	}
	if idx == 1 {
		return "12 sec"
	}
	if idx == 2 {
		return "30 sec"
	}
	if idx == 3 {
		return "60s (1m)"
	}
	if idx == 4 {
		return "300s (5m)"
	}
	return "3600s (1h)"
}

func nearestStopIdx(sec int) int {
	bestIdx := 1
	bestDiff := 999999
	for i := 0; i < 6; i++ {
		s := stopSeconds(i)
		d := sec - s
		if d < 0 {
			d = -d
		}
		if d < bestDiff {
			bestDiff = d
			bestIdx = i
		}
	}
	return bestIdx
}

func parsePositiveIntFromCfgBuf(n int) int {
	val := 0
	digits := 0
	for i := 0; i < n; i++ {
		ch := int(cfgBuf[i])
		if ch >= '0' && ch <= '9' {
			val = val*10 + (ch - '0')
			digits++
		} else if digits > 0 {
			break
		}
	}
	if digits > 0 && val > 0 {
		return val
	}
	return 0
}

func loadGalleryConfig() {
	slideStopIdx = 1
	slideSec = 12
	n := fs_read("/flash/etc/gallery.cfg", 0, &cfgBuf[0], 15)
	if n > 0 {
		val := parsePositiveIntFromCfgBuf(n)
		if val > 0 {
			slideStopIdx = nearestStopIdx(val)
			slideSec = stopSeconds(slideStopIdx)
		}
	}
	argLen := os_get_app_arg(&cfgBuf[0], 15)
	if argLen > 0 {
		argVal := parsePositiveIntFromCfgBuf(argLen)
		if argVal > 0 {
			slideStopIdx = nearestStopIdx(argVal)
			slideSec = argVal
		}
	}
}

func saveGalleryConfig() {
	fs_mkdir("/flash/etc", 1)
	v := slideSec
	if v <= 0 {
		v = 12
	}
	var rev [12]byte
	rLen := 0
	for v > 0 && rLen < 10 {
		rev[rLen] = byte('0' + (v % 10))
		v = v / 10
		rLen++
	}
	pos := 0
	for i := rLen - 1; i >= 0; i-- {
		cfgBuf[pos] = rev[i]
		pos++
	}
	cfgBuf[pos] = '\n'
	pos++
	fs_write("/flash/etc/gallery.cfg", &cfgBuf[0], pos)
}

func toLowerByte(c int) int {
	if c >= 'A' && c <= 'Z' {
		return c + 32
	}
	return c
}

// Returns the basename length (1..8) if the entry name ends with ".jpg" (case-insensitive)
// and its basename (without ".jpg") is 1..8 bytes; returns 0 otherwise.
func jpgBasenameLen(nameAddr int) int {
	ln := 0
	for ln < 63 {
		if peek1(nameAddr+ln) == 0 {
			break
		}
		ln++
	}
	// Need at least 1 basename byte + ".jpg" (4 bytes) = 5 bytes,
	// and at most 8 basename bytes + ".jpg" (4 bytes) = 12 bytes.
	if ln < 5 || ln > 12 {
		return 0
	}
	c0 := peek1(nameAddr + ln - 4)
	c1 := toLowerByte(peek1(nameAddr + ln - 3))
	c2 := toLowerByte(peek1(nameAddr + ln - 2))
	c3 := toLowerByte(peek1(nameAddr + ln - 1))
	if c0 == '.' && c1 == 'j' && c2 == 'p' && c3 == 'g' {
		return ln - 4
	}
	return 0
}

func exitCleanly() {
	os_prefetch_cancel()
	os_exit(0)
}

func isAmbientQuiet(now int) bool {
	if (now - appStartMs) < AMBIENT_HIDE_MS {
		return false
	}
	if lastTouchClickMs != 0 && (now - lastTouchClickMs) < AMBIENT_HIDE_MS {
		return false
	}
	return true
}

func drawGalleryWedges() {
	DrawExitWedge()
	DrawMenuWedge()
	wedgesVisible = 1
}

func hideGalleryWedges() {
	s := CornerSize()
	tft_fill_rect(0, 0, s, s, BLACK)
	tft_fill_rect(320-s, 0, s, s, BLACK)
	wedgesVisible = 0
}

func updateGalleryWedgesForNow(now int) {
	if isAmbientQuiet(now) {
		if wedgesVisible != 0 {
			hideGalleryWedges()
		}
	} else {
		if wedgesVisible == 0 {
			drawGalleryWedges()
		}
	}
}

func drawGalleryConfigPanel() {
	drawGalleryWedges()
	tft_fill_round_rect(12, 34, 296, 172, 6, 0x1082)
	tft_draw_round_rect(12, 34, 296, 172, 6, CYAN)
	tft_fill_round_rect(16, 38, 288, 24, 4, NAVY)

	tft_set_text_datum(MC_DATUM)
	tft_set_text_color(WHITE, NAVY)
	tft_draw_string("GALLERY CONFIG", 160, 50, 2)

	tft_set_text_datum(ML_DATUM)
	tft_set_text_color(LIGHTGREY, 0x1082)
	tft_draw_string("Seconds per photo:", 24, 78, 2)

	tft_fill_round_rect(182, 66, 114, 24, 4, 0x18E3)
	tft_draw_round_rect(182, 66, 114, 24, 4, CYAN)
	tft_set_text_datum(MC_DATUM)
	tft_set_text_color(YELLOW, 0x18E3)
	tft_draw_string(stopBadgeLabel(slideStopIdx), 239, 78, 2)

	// Slider with 6 stops: 5, 12, 30, 60, 300, 3600 at x = 35, 85, 135, 185, 235, 285
	trackX0 := 35
	stepX := 50
	trackW := stepX * 5
	tft_fill_round_rect(trackX0, 113, trackW, 6, 3, BLACK)
	if slideStopIdx > 0 {
		tft_fill_round_rect(trackX0, 113, slideStopIdx*stepX, 6, 3, CYAN)
	}
	tft_draw_round_rect(trackX0, 113, trackW, 6, 3, WHITE)

	tft_set_text_datum(TC_DATUM)
	for i := 0; i < 6; i++ {
		sx := trackX0 + i*stepX
		if i == slideStopIdx {
			tft_draw_line(sx, 108, sx, 124, YELLOW)
			tft_fill_circle(sx, 116, 6, YELLOW)
			tft_draw_circle(sx, 116, 6, WHITE)
			tft_set_text_color(YELLOW, 0x1082)
		} else {
			tft_draw_line(sx, 110, sx, 122, LIGHTGREY)
			tft_fill_circle(sx, 116, 3, 0x2945)
			tft_draw_circle(sx, 116, 3, CYAN)
			tft_set_text_color(LIGHTGREY, 0x1082)
		}
		tft_draw_string(stopLabel(i), sx, 130, 1)
	}

	// [DONE] button
	tft_fill_round_rect(100, 162, 120, 32, 5, 0x1A26)
	tft_draw_round_rect(100, 162, 120, 32, 5, GREEN)
	tft_set_text_datum(MC_DATUM)
	tft_set_text_color(WHITE, 0x1A26)
	tft_draw_string("DONE", 160, 178, 2)
	tft_set_text_datum(TL_DATUM)
}

func runGalleryConfigPanel() int {
	drawGalleryConfigPanel()

	sliderDragging := false
	for {
		if os_serial_available() > 0 {
			ch := os_serial_read()
			if ch == 'q' || ch == 'Q' || ch == 3 {
				exitCleanly()
				return 99
			}
		}
		if sliderDragging {
			td, tx, ty := os_read_touch()
			if !td {
				sliderDragging = false
			} else if ty >= 94 && ty <= 150 && tx >= 15 && tx <= 305 {
				now := os_millis()
				lastSlideClickMs = now
				lastTouchClickMs = now
				idx := (tx - 35 + 25) / 50
				if idx < 0 {
					idx = 0
				}
				if idx > 5 {
					idx = 5
				}
				if idx != slideStopIdx {
					slideStopIdx = idx
					slideSec = stopSeconds(idx)
					saveGalleryConfig()
					drawGalleryConfigPanel()
				}
			}
		} else {
			clicked, tx, ty := os_read_click()
			if clicked {
				now := os_millis()
				lastSlideClickMs = now
				lastTouchClickMs = now

				if ty >= 94 && ty <= 150 && tx >= 15 && tx <= 305 {
					idx := (tx - 35 + 25) / 50
					if idx < 0 {
						idx = 0
					}
					if idx > 5 {
						idx = 5
					}
					if idx != slideStopIdx {
						slideStopIdx = idx
						slideSec = stopSeconds(idx)
						saveGalleryConfig()
						drawGalleryConfigPanel()
					}
					sliderDragging = true
				} else if (tx >= 100 && tx <= 220 && ty >= 162 && ty <= 194) ||
					tx < 12 || tx > 308 || ty < 34 || ty > 206 {
					saveGalleryConfig()
					return 2
				}
			}
		}
		os_delay_ms(20)
	}
}

func runGalleryMenu() int {
	drawGalleryWedges()
	s := CornerSize()
	menuY := s
	if menuY < 24 {
		menuY = 24
	}
	tft_fill_round_rect(204, menuY, 114, 61, 5, 0x10A2)
	tft_draw_round_rect(204, menuY, 114, 61, 5, CYAN)

	tft_set_text_datum(MC_DATUM)
	for i := 0; i < 2; i++ {
		iy := menuY + 3 + i*29
		tft_fill_round_rect(208, iy, 106, 25, 4, 0x18E3)
		tft_draw_round_rect(208, iy, 106, 25, 4, CYAN)
		tft_set_text_color(WHITE, 0x18E3)
		if i == 0 {
			tft_draw_string("Shuffle", 261, iy+12, 2)
		} else {
			tft_draw_string("Config", 261, iy+12, 2)
		}
	}
	tft_set_text_datum(TL_DATUM)

	for {
		if os_serial_available() > 0 {
			ch := os_serial_read()
			if ch == 'q' || ch == 'Q' || ch == 3 {
				exitCleanly()
				return 99
			}
		}
		clicked, cx, cy := os_read_click()
		if clicked {
			now := os_millis()
			lastSlideClickMs = now
			lastTouchClickMs = now
			if cx >= 204 && cx <= 318 && cy >= menuY+2 && cy < menuY+60 {
				itemIdx := (cy - (menuY + 3)) / 29
				if itemIdx == 0 {
					shuffleCatalog()
					return 1
				}
				if itemIdx == 1 {
					return runGalleryConfigPanel()
				}
			}
			// Tapped Menu Wedge or outside dropdown -> close menu and redraw current slide
			return 2
		}
		os_delay_ms(POLL_STEP_MS)
	}
}

// pollUserAction returns:
//   99 = exit (serial 'q'/'Q'/^C; top-left Exit X is handled by Core 0)
//    2 = redraw current picture (after closing dropdown menu)
//    1 = next picture (click on right half: x >= 160)
//   -1 = previous picture (click on left half: x < 160, outside Exit X corner)
//    0 = no action
func pollUserAction() int {
	if os_serial_available() > 0 {
		ch := os_serial_read()
		if ch == 'q' || ch == 'Q' || ch == 3 {
			exitCleanly()
			return 99
		}
	}
	clicked, cx, cy := os_read_click()
	if clicked {
		now := os_millis()
		if lastSlideClickMs != 0 && (now-lastSlideClickMs) < 250 {
			return 0
		}
		lastSlideClickMs = now
		lastTouchClickMs = now
		if wedgesVisible == 0 {
			drawGalleryWedges()
		}
		if IsMenuWedge(cx, cy) {
			return runGalleryMenu()
		}
		if cx >= 160 {
			return 1
		}
		return -1
	}
	return 0
}

func checkHomeExit() bool {
	return pollUserAction() == 99
}

// waitSlideAction waits up to durationMs while polling for HOME exit, menu wedge, or left/right navigation clicks.
func waitSlideAction(durationMs int) int {
	startMs := os_millis()
	for (os_millis() - startMs) < durationMs {
		now := os_millis()
		if wedgesVisible != 0 && isAmbientQuiet(now) {
			hideGalleryWedges()
		}
		act := pollUserAction()
		if act != 0 {
			return act
		}
		os_delay_ms(POLL_STEP_MS)
	}
	return pollUserAction()
}

// waitWithHomePoll waits up to durationMs while polling the HOME button.
func waitWithHomePoll(durationMs int) bool {
	return waitSlideAction(durationMs) == 99
}

// buildNetJpgPath writes "/net/pix/<basename>.jpg" into pathBuf and returns its string slice.
func buildNetJpgPath(idx int) string {
	// Prefix: "/net/pix/" (9 bytes)
	pathBuf[0] = '/'
	pathBuf[1] = 'n'
	pathBuf[2] = 'e'
	pathBuf[3] = 't'
	pathBuf[4] = '/'
	pathBuf[5] = 'p'
	pathBuf[6] = 'i'
	pathBuf[7] = 'x'
	pathBuf[8] = '/'

	pos := 9
	nameAddr := int(&imgNames) + idx*NAME_STRIDE
	for i := 0; i < NAME_STRIDE; i++ {
		ch := peek1(nameAddr + i)
		if ch == 0 {
			break
		}
		pathBuf[pos] = byte(ch)
		pos++
	}
	pathBuf[pos] = '.'
	pathBuf[pos+1] = 'j'
	pathBuf[pos+2] = 'p'
	pathBuf[pos+3] = 'g'
	pos += 4
	pathBuf[pos] = 0
	return make_slice(&pathBuf[0], 32, pos)
}

func formatRetryLine(sec int) string {
	retryMsgBuf[0] = 'R'
	retryMsgBuf[1] = 'e'
	retryMsgBuf[2] = 't'
	retryMsgBuf[3] = 'r'
	retryMsgBuf[4] = 'y'
	retryMsgBuf[5] = 'i'
	retryMsgBuf[6] = 'n'
	retryMsgBuf[7] = 'g'
	retryMsgBuf[8] = ' '
	retryMsgBuf[9] = 'i'
	retryMsgBuf[10] = 'n'
	retryMsgBuf[11] = ' '
	pos := 12

	v := sec
	if v < 1 {
		v = 1
	}
	var rev [12]byte
	rLen := 0
	for v > 0 && rLen < 10 {
		rev[rLen] = byte('0' + (v % 10))
		v = v / 10
		rLen++
	}
	for i := rLen - 1; i >= 0; i-- {
		retryMsgBuf[pos] = rev[i]
		pos++
	}

	retryMsgBuf[pos] = ' '
	retryMsgBuf[pos+1] = 's'
	retryMsgBuf[pos+2] = 'e'
	retryMsgBuf[pos+3] = 'c'
	retryMsgBuf[pos+4] = 'o'
	retryMsgBuf[pos+5] = 'n'
	retryMsgBuf[pos+6] = 'd'
	pos += 7
	if sec != 1 {
		retryMsgBuf[pos] = 's'
		pos++
	}
	retryMsgBuf[pos] = '.'
	retryMsgBuf[pos+1] = '.'
	retryMsgBuf[pos+2] = '.'
	pos += 3
	retryMsgBuf[pos] = 0
	return make_slice(&retryMsgBuf[0], 36, pos)
}

func waitRetryCountdown(totalSec int) bool {
	tft_fill_screen(BLACK)
	if !isAmbientQuiet(os_millis()) {
		drawGalleryWedges()
	} else {
		wedgesVisible = 0
	}
	tft_set_text_color(CYAN, BLACK)
	tft_draw_string("No images in /net/pix/", 40, 100, 2)

	rem := totalSec
	for rem > 0 {
		tft_fill_rect(40, 122, 260, 20, BLACK)
		tft_set_text_color(LIGHTGREY, BLACK)
		tft_draw_string(formatRetryLine(rem), 40, 124, 2)
		act := waitSlideAction(1000)
		if act == 99 {
			return true
		}
		if act == 2 {
			tft_fill_screen(BLACK)
			if !isAmbientQuiet(os_millis()) {
				drawGalleryWedges()
			} else {
				wedgesVisible = 0
			}
			tft_set_text_color(CYAN, BLACK)
			tft_draw_string("No images in /net/pix/", 40, 100, 2)
		}
		rem = rem - 1
	}
	return false
}

func startPrefetch(idx int) {
	if idx < 0 || idx >= imgCount {
		prefetchIdx = -1
		return
	}
	fullPath := buildNetJpgPath(idx)
	if os_prefetch_start(fullPath, &imgBuf, BUF_MAX) != 0 {
		prefetchIdx = idx
	} else {
		prefetchIdx = -1
	}
}

func swapCatalogEntries(i int, j int) {
	if i == j {
		return
	}
	addrI := int(&imgNames) + i*NAME_STRIDE
	addrJ := int(&imgNames) + j*NAME_STRIDE
	w0 := peek4(addrI)
	w1 := peek4(addrI + 4)
	poke4(addrI, peek4(addrJ))
	poke4(addrI+4, peek4(addrJ+4))
	poke4(addrJ, w0)
	poke4(addrJ+4, w1)
}

func shuffleCatalog() {
	for i := imgCount - 1; i > 0; i-- {
		j := int(os_rand(uint(i + 1)))
		swapCatalogEntries(i, j)
	}
}

func scanCatalog() int {
	os_prefetch_cancel()
	imgCount = 0
	prefetchIdx = -1

	// Reuse imgBuf temporarily for up to MAX_SCAN (700) LakatosFsEntry structs (700 * 88 = 61,600 B)
	n := fs_ls("/net/pix", &imgBuf, MAX_SCAN)
	if n <= 0 {
		return 0
	}

	baseBuf := int(&imgBuf)
	for i := 0; i < n; i++ {
		if imgCount >= MAX_IMAGES {
			break
		}
		entAddr := baseBuf + i*ENTRY_SIZE
		isDir := peek1(entAddr + ENTRY_ISDIR)
		firstCh := peek1(entAddr)
		if isDir != 0 || firstCh == 0 || firstCh == '.' {
			continue
		}
		baseLen := jpgBasenameLen(entAddr)
		if baseLen <= 0 {
			continue
		}
		dstName := int(&imgNames) + imgCount*NAME_STRIDE
		poke4(dstName, 0)
		poke4(dstName+4, 0)
		for c := 0; c < baseLen; c++ {
			poke1(dstName+c, peek1(entAddr+c))
		}
		imgCount++
	}
	shuffleCatalog()
	return imgCount
}

func displaySlide(idx int) bool {
	drawn := false

	if prefetchIdx != idx {
		startPrefetch(idx)
	}
	st, got := os_prefetch_status()
	for st == 1 {
		if checkHomeExit() {
			return false
		}
		os_delay_ms(15)
		st, got = os_prefetch_status()
	}
	if st == 2 && got > 0 {
		tft_fill_screen(BLACK)
		// x = -1 centers the image horizontally and vertically on the 320x240 screen
		drawn = tft_draw_jpg(&imgBuf, got, -1, 0, 0)
	}

	// Fallback to streaming directly from VFS if not drawn from RAM buffer
	if !drawn {
		fullPath := buildNetJpgPath(idx)
		tft_fill_screen(BLACK)
		drawn = tft_draw_jpg_file(fullPath, -1, 0, 0)
	}

	if drawn {
		if !isAmbientQuiet(os_millis()) {
			drawGalleryWedges()
		} else {
			wedgesVisible = 0
		}
	}

	// Immediately start Core 0 background prefetch for the NEXT slide during the 10s wait
	if imgCount > 0 {
		nextIdx := idx + 1
		if nextIdx >= imgCount {
			nextIdx = 0
		}
		startPrefetch(nextIdx)
	}

	return drawn
}

func main() {
	appStartMs = os_millis()
	lastTouchClickMs = 0
	loadGalleryConfig()
	tft_fill_screen(BLACK)
	drawGalleryWedges()
	tft_set_text_color(CYAN, BLACK)
	tft_draw_string("Loading /net/pix/ ...", 64, 110, 2)

	retrySec := 3
	for {
		count := scanCatalog()

		if count > 0 {
			idx := 0
			failures := 0
			for failures < count {
				if displaySlide(idx) {
					failures = 0
					retrySec = 3
					act := waitSlideAction(slideSec * 1000)
					if act == 99 {
						return
					}
					if act == 2 {
						// Menu closed without advancing -> redraw current slide
						continue
					}
					if act == -1 {
						idx = idx - 1
						if idx < 0 {
							idx = count - 1
						}
					} else {
						idx = idx + 1
						if idx >= count {
							idx = 0
						}
					}
				} else {
					if checkHomeExit() {
						return
					}
					failures++
					idx = idx + 1
					if idx >= count {
						idx = 0
					}
				}
			}
		}

		if waitRetryCountdown(retrySec) {
			return
		}
		retrySec = retrySec + 1

		tft_fill_screen(BLACK)
		if !isAmbientQuiet(os_millis()) {
			drawGalleryWedges()
		} else {
			wedgesVisible = 0
		}
		tft_set_text_color(CYAN, BLACK)
		tft_draw_string("Loading /net/pix/ ...", 64, 110, 2)
	}
}
