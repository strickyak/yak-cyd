}

func updateCamera() {
	camSin = sin(myTheta)
	camCos = cos(myTheta)

	// Position camera behind and slightly above the local avatar
	camX = myX - camSin*82.0
	camY = myY - camCos*82.0
	camZ = myZ + 38.0
	camPitch = -0.16
}

func appendAvatarPrim(primIdx int, ax float32, ay float32, az float32, theta float32, bodyCol int, isSelf int) {
	b := primIdx * 16
	scenePrims[b+0] = 2.0 // PRIM3D_AVATAR
	scenePrims[b+1] = 1.0 // Active at all detail levels >= 1
	scenePrims[b+2] = float32(bodyCol)
	scenePrims[b+3] = float32(PAL_DARK)
	scenePrims[b+4] = ax
	scenePrims[b+5] = ay
	scenePrims[b+6] = az
	scenePrims[b+7] = theta
	scenePrims[b+8] = float32(isSelf)
	scenePrims[b+15] = 0.0 // outVis
}

// Renders all visible 3D world quads (filtered by detailLevel 1..4) and avatars via Lakatos OS pal4_render_3d()
func renderScene3D() {
	updateCamera()

	camParams[0] = camX
	camParams[1] = camY
	camParams[2] = camZ
	camParams[3] = myTheta
	camParams[4] = camPitch
	camParams[5] = FOCAL_LEN
	camParams[6] = float32(HORIZON_Y)
	camParams[7] = float32(PAL_SKY_TOP)
	camParams[8] = float32(PAL_SKY_HORIZ)
	camParams[9] = float32(PAL_GRASS)
	camParams[10] = float32(detailLevel)
	camParams[11] = 0.0

	primCount := quadCount

	// Local avatar
	bobZ := sin(myWalkPhase) * 1.2
	appendAvatarPrim(primCount, myX, myY, myZ+bobZ, myTheta, myColor, 1)
	primCount = primCount + 1

	// Remote WebSocket peers
	var i int
	for i = 0; i < MAX_PEERS; i = i + 1 {
		peerPrimIdx[i] = -1
		if peerActive[i] != 0 && primCount < MAX_ITEMS {
			peerPrimIdx[i] = primCount
			appendAvatarPrim(primCount, peerX[i], peerY[i], peerZ[i], peerTheta[i], peerColor[i], 0)
			primCount = primCount + 1
		}
	}

	// Autonomous Croquet bot avatar ("alan")
	botPrimIdx = -1
	if botEnabled != 0 && primCount < MAX_ITEMS {
		botPrimIdx = primCount
		appendAvatarPrim(primCount, botX, botY, botZ, botTheta, PAL_AV_GOLD, 0)
		primCount = primCount + 1
	}

	// Render entire 3D scene (horizon + frustum culling + depth sort + projection + pal4 rasterization) in C++
	pal4_render_3d(&canvas[0], VIEW_W, VIEW_H, &camParams[0], &scenePrims[0], primCount)

	// Blit the 320x216 4-bit viewport to the TFT in a single flicker-free call!
	tft_draw_pal4(VIEW_X, VIEW_Y, VIEW_W, VIEW_H, &palette[0], &canvas[0])

	// Overlay floating name tags above visible remote peers & bot
	tft_set_text_datum(1) // TC_DATUM
	for i = 0; i < MAX_PEERS; i = i + 1 {
		pIdx := peerPrimIdx[i]
		if pIdx >= 0 {
			b := pIdx * 16
			if int(scenePrims[b+15]) != 0 {
				sx := int(scenePrims[b+13])
				sy := VIEW_Y + int(scenePrims[b+14])
				if sx >= 20 && sx <= 300 && sy >= VIEW_Y+2 && sy <= VIEW_Y+VIEW_H-14 {
					tft_set_text_color(UI_CYAN, BLACK)
					tft_draw_cstr(&peerId[i*16], sx, sy, 1)
				}
			}
		}
	}
	if botPrimIdx >= 0 {
		b := botPrimIdx * 16
		if int(scenePrims[b+15]) != 0 {
			botSX := int(scenePrims[b+13])
			botSY := VIEW_Y + int(scenePrims[b+14])
			if botSX >= 20 && botSX <= 300 && botSY >= VIEW_Y+2 && botSY <= VIEW_Y+VIEW_H-14 {
				tft_set_text_color(UI_GOLD, BLACK)
				tft_draw_string("alan", botSX, botSY, 1)
			}
		}
	}
	tft_set_text_datum(0) // TL_DATUM
}

// ============================================================================
// Movement & Collision with House Walls & East Lake
// ============================================================================
func canStandAt(nx float32, ny float32) int {
	if nx < -250.0 || nx > 250.0 || ny < -270.0 || ny > 280.0 {
		return 0
	}
	if detailLevel >= 4 && nx > 112.0 && ny > -160.0 && ny < 160.0 {
		return 0
	}
	if detailLevel >= 2 {
		if ny > -98.0 && ny < -82.0 {
			if (nx > -86.0 && nx < -25.0) || (nx > 25.0 && nx < 86.0) {
				return 0
			}
		}
		if ny > 82.0 && ny < 98.0 {
			if (nx > -86.0 && nx < -25.0) || (nx > 25.0 && nx < 86.0) {
				return 0
			}
		}
		if ny > -94.0 && ny < 94.0 {
			if (nx > -88.0 && nx < -72.0) || (nx > 72.0 && nx < 88.0) {
				return 0
			}
		}
	}
	return 1
}

func moveAvatar(stepDist float32) {
	dx := sin(myTheta) * stepDist
	dy := cos(myTheta) * stepDist
	nx := myX + dx
	ny := myY + dy

	if canStandAt(nx, ny) != 0 {
		myX = nx
		myY = ny
	} else if canStandAt(nx, myY) != 0 {
		myX = nx
	} else if canStandAt(myX, ny) != 0 {
		myY = ny
	}
	myWalkPhase = myWalkPhase + 0.45
	if myWalkPhase > TWO_PI {
		myWalkPhase = myWalkPhase - TWO_PI
	}
}

func updateBot() {
	if botEnabled == 0 {
		return
	}
	botPhase = botPhase + 0.012
	if botPhase >= 4.0 {
		botPhase = botPhase - 4.0
	}

	if botPhase < 1.0 {
		t := botPhase
		botX = 14.0
		botY = -140.0 + t*290.0
		botTheta = 0.0
	} else if botPhase < 2.0 {
		t := botPhase - 1.0
		botX = 14.0 + t*82.0
		botY = 150.0
		botTheta = HALF_PI
	} else if botPhase < 3.0 {
		t := botPhase - 2.0
		botX = 96.0
		botY = 150.0 - t*290.0
		botTheta = 3.1415926
	} else {
		t := botPhase - 3.0
		botX = 96.0 - t*82.0
		botY = -140.0
		botTheta = -HALF_PI
	}
	botZ = sin(botPhase*25.0) * 1.0
	if botZ < 0.0 {
		botZ = 0.0
	}
}

// ============================================================================
// WebSocket Protocol Parsing & State Broadcast (/croquet)
// ============================================================================
func appendCStr(dst *byte, pos int, src *byte, maxSrc int) int {
	var i int
	for i = 0; i < maxSrc; i = i + 1 {
		ch := peek1(int(src) + i)
		if ch == 0 {
			break
		}
		poke1(int(dst)+pos, ch)
		pos = pos + 1
	}
	poke1(int(dst)+pos, 0)
	return pos
}

func appendIntStr(dst *byte, pos int, val int) int {
	if val == 0 {
		poke1(int(dst)+pos, '0')
		poke1(int(dst)+pos+1, 0)
		return pos + 1
	}
	if val < 0 {
		poke1(int(dst)+pos, '-')
		pos = pos + 1
		val = -val
	}
	n := 0
	for val > 0 && n < 16 {
		numBuf[n] = byte('0' + (val % 10))
		val = val / 10
		n = n + 1
	}
	for n > 0 {
		n = n - 1
		poke1(int(dst)+pos, int(numBuf[n]))
		pos = pos + 1
	}
	poke1(int(dst)+pos, 0)
	return pos
}

func sendPoseOverWs() {
	if wsConnected == 0 {
		return
	}
	poke1(int(&txBuf[0])+0, 'P')
	poke1(int(&txBuf[0])+1, 'O')
	poke1(int(&txBuf[0])+2, 'S')
	poke1(int(&txBuf[0])+3, 'E')
	poke1(int(&txBuf[0])+4, ' ')
	pos := 5
	pos = appendIntStr(&txBuf[0], pos, int(myX))
	poke1(int(&txBuf[0])+pos, ' ')
	pos = pos + 1
	pos = appendIntStr(&txBuf[0], pos, int(myY))
	poke1(int(&txBuf[0])+pos, ' ')
	pos = pos + 1
	pos = appendIntStr(&txBuf[0], pos, int(myZ))
	poke1(int(&txBuf[0])+pos, ' ')
	pos = pos + 1
	pos = appendIntStr(&txBuf[0], pos, int(myTheta*1000.0))
	poke1(int(&txBuf[0])+pos, ' ')
	pos = pos + 1
	pos = appendIntStr(&txBuf[0], pos, myColor)

	res := ws_send(&txBuf[0], pos)
	if res < 0 {
		wsConnected = 0
	}
}

func skipSpaces() {
	for parsePos < parseLen {
		ch := rxBuf[parsePos]
		if ch != ' ' && ch != '\t' && ch != '\r' {
			break
		}
		parsePos = parsePos + 1
	}
}

func readTokenTo(dst *byte, maxDst int) int {
	skipSpaces()
	var n int
	n = 0
	for parsePos < parseLen {
		ch := rxBuf[parsePos]
		if ch == 0 || ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n' {
			break
		}
		if n+1 < maxDst {
			poke1(int(dst)+n, int(ch))
			n = n + 1
		}
		parsePos = parsePos + 1
	}
	poke1(int(dst)+n, 0)
	return n
}

func readIntToken() int {
	skipSpaces()
	sign := 1
	if parsePos < parseLen && rxBuf[parsePos] == '-' {
		sign = -1
		parsePos = parsePos + 1
	}
	val := 0
	for parsePos < parseLen {
		ch := int(rxBuf[parsePos])
		if ch == '.' {
			parsePos = parsePos + 1
			for parsePos < parseLen {
				c2 := int(rxBuf[parsePos])
				if c2 < '0' || c2 > '9' {
					break
				}
				parsePos = parsePos + 1
			}
			break
		}
		if ch < '0' || ch > '9' {
			break
		}
		val = val*10 + (ch - '0')
		parsePos = parsePos + 1
	}
	return val * sign
}

func cstrEquals(a *byte, b *byte, maxL int) int {
	var i int
	for i = 0; i < maxL; i = i + 1 {
		ca := peek1(int(a) + i)
		cb := peek1(int(b) + i)
		if ca != cb {
			return 0
		}
		if ca == 0 {
			return 1
		}
	}
	return 1
}

func findOrAllocPeer(idPtr *byte) int {
	var i int
	for i = 0; i < MAX_PEERS; i = i + 1 {
		if peerActive[i] != 0 && cstrEquals(&peerId[i*16], idPtr, 15) != 0 {
			return i
		}
	}
	for i = 0; i < MAX_PEERS; i = i + 1 {
		if peerActive[i] == 0 {
			peerActive[i] = 1
			appendCStr(&peerId[i*16], 0, idPtr, 15)
			return i
		}
	}
	return -1
}

func recountPeers() {
	c := 0
	var i int
	for i = 0; i < MAX_PEERS; i = i + 1 {
		if peerActive[i] != 0 {
			c = c + 1
		}
	}
	activePeerCount = c
}

func mapAvatarColor(c int) int {
	if c == PAL_AV_CYAN || c == PAL_AV_GOLD || c == PAL_ROOF_LIT {
		return c
	}
	return PAL_ROOF_LIT
}

func processWsLine() {
	var cmd [16]byte
	var tokId [16]byte
	if readTokenTo(&cmd[0], 16) == 0 {
		return
	}

	if cmd[0] == 'Y' && cmd[1] == 'O' && cmd[2] == 'U' && cmd[3] == 0 {
		if readTokenTo(&myIdBuf[0], 20) > 0 {
			h := (int(myIdBuf[0]) + int(myIdBuf[1])*3 + int(myIdBuf[2])*7) % 3
			if h == 0 {
				myColor = PAL_AV_CYAN
			} else if h == 1 {
				myColor = PAL_AV_GOLD
			} else {
				myColor = PAL_ROOF_LIT
			}
		}
		return
	}

	if cmd[0] == 'S' && cmd[1] == 'T' && cmd[2] == 'A' && cmd[3] == 'T' && cmd[4] == 'E' && cmd[5] == 0 {
		if readTokenTo(&tokId[0], 16) == 0 {
			return
		}
		if myIdBuf[0] != 0 && cstrEquals(&tokId[0], &myIdBuf[0], 15) != 0 {
			return
		}
		px := float32(readIntToken())
		py := float32(readIntToken())
		pz := float32(readIntToken())
		ptMrad := readIntToken()
		pcol := mapAvatarColor(readIntToken())
		slot := findOrAllocPeer(&tokId[0])
		if slot >= 0 {
			peerX[slot] = px
			peerY[slot] = py
			peerZ[slot] = pz
			peerTheta[slot] = float32(ptMrad) * 0.001
			peerColor[slot] = pcol
			recountPeers()
		}
		return
	}

	if cmd[0] == 'L' && cmd[1] == 'E' && cmd[2] == 'A' && cmd[3] == 'V' && cmd[4] == 'E' && cmd[5] == 0 {
		if readTokenTo(&tokId[0], 16) == 0 {
			return
		}
		var i int
		for i = 0; i < MAX_PEERS; i = i + 1 {
			if peerActive[i] != 0 && cstrEquals(&peerId[i*16], &tokId[0], 15) != 0 {
				peerActive[i] = 0
			}
		}
		recountPeers()
	}
}

func pollWebSocket(nowMs int) {
	if wsConnected == 0 {
		if nowMs-wsLastRetryMs >= 4000 {
			wsLastRetryMs = nowMs
			if ws_open("/croquet") != 0 {
				wsConnected = 1
				sendPoseOverWs()
				wsLastSendMs = nowMs
			}
		}
		return
	}

	var iter int
	for iter = 0; iter < 6; iter = iter + 1 {
		got := ws_recv(&rxBuf[0], 255)
		if got < 0 {
			wsConnected = 0
			wsLastRetryMs = nowMs
			break
		}
		if got == 0 {
			break
		}
		rxBuf[got] = 0
		parsePos = 0
		parseLen = got
		for parsePos < parseLen {
			processWsLine()
			for parsePos < parseLen && rxBuf[parsePos] != '\n' {
				parsePos = parsePos + 1
			}
			if parsePos < parseLen && rxBuf[parsePos] == '\n' {
				parsePos = parsePos + 1
			}
		}
	}
}

// ============================================================================
// UI Header Bar:
//   - Top-left exit wedge (x = 0..11)
//   - Unlabeled 1..4 Detail Slider (x = 20..110)
//   - Live FPS number next to slider (x = 118..154, updated once per second)
//   - Green/Red WebSocket status circle (x = 174)
//   - [ALAN] bot toggle (x = 206..258) & [EXIT] button (x = 264..316)
// ============================================================================
func drawFpsBadge() {
	tft_fill_rect(116, 2, 42, 20, UI_BG)
	tft_set_text_datum(4) // MC_DATUM
	tft_set_text_color(UI_GOLD, UI_BG)
	tft_draw_int(fpsValue, 136, 12, 2)
	tft_set_text_datum(0)
}

func drawHeaderBar() {
	tft_fill_rect(0, 0, 320, 24, UI_BG)
	tft_draw_fast_hline(0, 23, 320, UI_BORDER)

	// Standard top-left exit wedge
	DrawExitWedge()

	// Unlabeled 1..4 Detail Slider (stops at x = 28, 52, 76, 100)
	tft_fill_rect(28, 10, 72, 4, UI_BTN_BG)
	tft_draw_rect(28, 10, 72, 4, UI_BORDER)
	var d int
	for d = 1; d <= 4; d = d + 1 {
		tx := 28 + (d-1)*24
		tft_draw_fast_vline(tx, 6, 12, UI_LIGHTGREY)
	}
	knobX := 28 + (detailLevel-1)*24
	tft_fill_round_rect(knobX-8, 3, 17, 17, 4, UI_BTN_ACT)
	tft_draw_round_rect(knobX-8, 3, 17, 17, 4, UI_CYAN)
	tft_set_text_datum(4) // MC_DATUM
	tft_set_text_color(WHITE, UI_BTN_ACT)
	tft_draw_int(detailLevel, knobX, 11, 2)

	// FPS Number next to the slider
	drawFpsBadge()

	// Green / Red WebSocket Connection Circle at x = 174, y = 11
	if wsConnected != 0 {
		tft_fill_circle(174, 11, 6, UI_GREEN)
		tft_draw_circle(174, 11, 7, WHITE)
		if activePeerCount > 0 {
			tft_set_text_datum(0)
			tft_set_text_color(UI_GREEN, UI_BG)
			tft_draw_int(activePeerCount, 186, 4, 2)
		}
	} else {
		tft_fill_circle(174, 11, 6, RED)
		tft_draw_circle(174, 11, 7, UI_LIGHTGREY)
	}

	// [ALAN] bot toggle button
	tft_set_text_datum(4) // MC_DATUM
	botBg := UI_BTN_BG
	if botEnabled != 0 {
		botBg = UI_BTN_ACT
	}
	tft_fill_round_rect(206, 3, 52, 17, 3, botBg)
	tft_draw_round_rect(206, 3, 52, 17, 3, UI_CYAN)
	tft_set_text_color(WHITE, botBg)
	tft_draw_string("ALAN", 232, 11, 1)

	// [EXIT] button
	tft_fill_round_rect(264, 3, 52, 17, 3, MAROON)
	tft_draw_round_rect(264, 3, 52, 17, 3, RED)
	tft_set_text_color(WHITE, MAROON)
	tft_draw_string("EXIT", 290, 11, 1)
	tft_set_text_datum(0)
}

func main() {
	os_set_corner_exit(1)
	initPalette()
	initWorldGeometry()

	detailLevel = 4
	fpsFrames = 0
	fpsValue = 0
	fpsLastMs = millis()

	// Start in the front courtyard facing North (+Y) toward the open front door & North mountains
	myX = -10.0
	myY = -175.0
	myZ = 0.0
	myTheta = 0.0
	myColor = PAL_AV_CYAN
	myWalkPhase = 0.0

	botEnabled = 1
	botPhase = 0.14
	updateBot()

	wsConnected = 0
	wsLastRetryMs = -5000
	wsLastSendMs = 0

	if ws_open("/croquet") != 0 {
		wsConnected = 1
		sendPoseOverWs()
	}

	drawHeaderBar()
	renderScene3D()

	wasTopTap := 0
	prevHeaderState := -1
	poseDirty := 0

	for {
		nowMs := millis()

		// Update FPS counter once per second (every 1000 ms)
		fpsFrames = fpsFrames + 1
		elapsed := nowMs - fpsLastMs
		if elapsed >= 1000 {
			fpsValue = (fpsFrames * 1000) / elapsed
			fpsFrames = 0
			fpsLastMs = nowMs
			drawFpsBadge()
		}

		// Drain any non-fuse serial commands ('q' or Ctrl+C to exit)
		if os_serial_available() > 0 {
			ch := os_serial_read()
			if ch == 'q' || ch == 3 {
				ws_close()
				return
			}
		}

		// Continuous touch polling on the full 320x216 3D viewport and top header
		var tx int
		var ty int
		action := 0
		if read_touch(&tx, &ty) != 0 {
			if (tx < 16 && ty < 24) || (tx >= 264 && ty < 24) {
				ws_close()
				return
			}
			// Unlabeled 1..4 Detail Slider touch zone (x = 16..114, y = 0..23)
			if tx >= 16 && tx <= 114 && ty < 24 {
				newDetail := 1
				if tx >= 88 {
					newDetail = 4
				} else if tx >= 64 {
					newDetail = 3
				} else if tx >= 40 {
					newDetail = 2
				}
				if newDetail != detailLevel {
					detailLevel = newDetail
					drawHeaderBar()
				}
			} else if tx >= 206 && tx <= 258 && ty < 24 {
				if wasTopTap == 0 {
					wasTopTap = 1
					if botEnabled != 0 {
						botEnabled = 0
					} else {
						botEnabled = 1
					}
					drawHeaderBar()
				}
			} else {
				wasTopTap = 0
			}
			if ty >= VIEW_Y {
				// Direct 3D viewport steering:
				//   Left third (x < 96)   -> Turn Left
				//   Right third (x > 224) -> Turn Right
				//   Center (96..224)      -> Walk Forward
				if tx < 96 {
					action = 1
				} else if tx > 224 {
					action = 4
				} else {
					action = 2
				}
			}
		} else {
			wasTopTap = 0
		}

		if action == 1 {
			myTheta = myTheta - 0.065
			if myTheta < -3.1415926 {
				myTheta = myTheta + TWO_PI
			}
			poseDirty = 1
		} else if action == 4 {
			myTheta = myTheta + 0.065
			if myTheta > 3.1415926 {
				myTheta = myTheta - TWO_PI
			}
			poseDirty = 1
		} else if action == 2 {
			moveAvatar(3.4)
			poseDirty = 1
		}

		// Poll WebSocket for peer updates and send our pose delta if we moved
		pollWebSocket(nowMs)
		if wsConnected != 0 {
			if (poseDirty != 0 && nowMs-wsLastSendMs >= 100) || (nowMs-wsLastSendMs >= 3000) {
				sendPoseOverWs()
				wsLastSendMs = nowMs
				poseDirty = 0
			}
		}

		hdrState := detailLevel*1000 + wsConnected*100 + activePeerCount*10 + botEnabled
		if hdrState != prevHeaderState {
			drawHeaderBar()
			prevHeaderState = hdrState
		}

		updateBot()
		renderScene3D()
		os_yield()
	}
}
