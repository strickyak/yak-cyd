package main

import "wedge"

// ============================================================================
// Croquet 3D — Multi-User Shared 3D World for CYD (Inspired by Alan Kay et al.)
// ============================================================================
// - Top bar includes:
//     * Unlabeled 1..4 Detail Slider:
//         1 = Floor and horizons
//         2 = Adds the 3D house and original simple courtyard wickets
//         3 = Adds 1 tree (West), 1 brown mountain (North), 1 railroad bedrock (South)
//         4 = Adds the rest (remaining mountains, trees, East lake, railroad ties & rails)
//     * Live FPS counter next to the slider (updates once per second)
//     * Green/Red WebSocket status circle + [ALAN] bot toggle + [EXIT]
// ============================================================================

const (
	VIEW_X = 0
	VIEW_Y = 24
	VIEW_W = 320
	VIEW_H = 216

	HORIZON_Y = 78
	FOCAL_LEN = 165.0

	// 16-Color pal4 Palette Indices
	PAL_SKY_TOP    = 0
	PAL_SKY_HORIZ  = 1
	PAL_GRASS      = 2
	PAL_PATH       = 3
	PAL_FLOOR      = 4
	PAL_WALL_LIT   = 5
	PAL_WALL_SHADE = 6
	PAL_LAKE       = 7
	PAL_ROOF_LIT   = 8
	PAL_MTN_BROWN  = 9
	PAL_TIMBER     = 10
	PAL_WHITE      = 11
	PAL_DARK       = 12
	PAL_AV_CYAN    = 13
	PAL_AV_GOLD    = 14
	PAL_TREE_GREEN = 15

	// RGB565 UI Colors
	UI_BG        = 0x10A3
	UI_BTN_BG    = 0x2188
	UI_BTN_ACT   = 0x0451
	UI_BORDER    = 0x5B91
	UI_GOLD      = 0xFEA0
	UI_CYAN      = 0x07FF
	UI_GREEN     = 0x07E0
	UI_LIGHTGREY = 0xD69A

	MAX_QUADS = 128
	MAX_PEERS = 8
	MAX_ITEMS = 144
	TWO_PI    = 6.2831853
	HALF_PI   = 1.5707963
)

// Off-screen 4-bit framebuffer (320 * 216 / 2 = 34,560 bytes)
var canvas [34560]byte
var palette [16]int

// 3D World Quad Table + Minimum Detail Level (1..4) per Quad
var quadCount int
var qX0 [128]float32
var qY0 [128]float32
var qZ0 [128]float32
var qX1 [128]float32
var qY1 [128]float32
var qZ1 [128]float32
var qX2 [128]float32
var qY2 [128]float32
var qZ2 [128]float32
var qX3 [128]float32
var qY3 [128]float32
var qZ3 [128]float32
var qCol [128]int
var qMinDetail [128]int

// Precomputed Static Quad Centroids, Bounding Half-Extents, Culling & Sort Biases
var qCX [128]float32
var qCY [128]float32
var qCZ [128]float32
var qHalfX [128]float32
var qHalfY [128]float32
var qMinRY [128]float32
var qBias [128]float32
var qIsTri [128]int

// Current Detail Level (1..4) and FPS Measurement State
var detailLevel int
var fpsFrames int
var fpsLastMs int
var fpsValue int

// Painter's Algorithm Draw Order List (Quads + Avatars)
// itemKind: 0..127 = quad index, 200 = local avatar, 201..208 = remote peers, 209 = bot avatar
var itemCount int
var itemKind [144]int
var itemDepth [144]float32

// Local Avatar State
var myX float32
var myY float32
var myZ float32
var myTheta float32
var myColor int
var myWalkPhase float32

// Camera State (Computed from myX, myY, myZ, myTheta)
var camX float32
var camY float32
var camZ float32
var camSin float32
var camCos float32
var camAbsSin float32
var camAbsCos float32
var camPitch float32
var camSinP float32
var camCosP float32

// 3D -> 2D Projection Outputs (Single-return convention for LGolf)
var projSX int
var projSY int
var projDepth float32

// Remote Peer Avatars (Synchronized via /croquet WebSocket)
var peerActive [8]int
var peerId [128]byte // 8 * 16-byte null-terminated IDs
var peerX [8]float32
var peerY [8]float32
var peerZ [8]float32
var peerTheta [8]float32
var peerColor [8]int
var peerScreenX [8]int
var peerScreenY [8]int
var peerScreenVis [8]int
var activePeerCount int

// Autonomous "Alan" Bot Avatar (strolls through both open doors of the house)
var botEnabled int
var botPhase float32
var botX float32
var botY float32
var botZ float32
var botTheta float32
var botScreenX int
var botScreenY int
var botScreenVis int

// WebSocket State & Scratch Buffers
var wsConnected int
var wsLastSendMs int
var wsLastRetryMs int
var myIdBuf [24]byte
var rxBuf [256]byte
var txBuf [96]byte
var numBuf [20]byte

// Parse state for incoming WebSocket lines
var parsePos int
var parseLen int

func initPalette() {
	palette[PAL_SKY_TOP] = 0x2335    // Deep cerulean sky
	palette[PAL_SKY_HORIZ] = 0x6D9E  // Soft horizon sky blue / water shimmer
	palette[PAL_GRASS] = 0x24E6      // Lush courtyard grass green
	palette[PAL_PATH] = 0xC5B2       // Warm sandstone path / shore / track ballast
	palette[PAL_FLOOR] = 0x8C71      // Stone floor / steel train rails
	palette[PAL_WALL_LIT] = 0xF759   // Sunlit cream stucco wall
	palette[PAL_WALL_SHADE] = 0xC591 // Shaded warm stucco wall
	palette[PAL_LAKE] = 0x039B       // Deep azure blue East Lake water
	palette[PAL_ROOF_LIT] = 0xC263   // Terracotta roof / coral-red avatar
	palette[PAL_MTN_BROWN] = 0x8304  // Sunlit brown mountain slope
	palette[PAL_TIMBER] = 0x51E3     // Shaded brown mountain / tree trunk / railroad ties
	palette[PAL_WHITE] = 0xFFFF      // Pure white highlight / sclera
	palette[PAL_DARK] = 0x1082       // Deep charcoal pupil / shadow
	palette[PAL_AV_CYAN] = 0x06FF    // Avatar Cyan
	palette[PAL_AV_GOLD] = 0xFD60    // Avatar Gold
	palette[PAL_TREE_GREEN] = 0x1362 // Deep forest pine green for West trees
}

func maxAbsDiff(c float32, v float32, curMax float32) float32 {
	d := abs(v - c)
	if d > curMax {
		return d
	}
	return curMax
}

func addQuad(x0 float32, y0 float32, z0 float32,
	x1 float32, y1 float32, z1 float32,
	x2 float32, y2 float32, z2 float32,
	x3 float32, y3 float32, z3 float32, col int, minDetail int) {
	if quadCount >= MAX_QUADS {
		return
	}
	i := quadCount
	qX0[i] = x0
	qY0[i] = y0
	qZ0[i] = z0
	qX1[i] = x1
	qY1[i] = y1
	qZ1[i] = z1
	qX2[i] = x2
	qY2[i] = y2
	qZ2[i] = z2
	qX3[i] = x3
	qY3[i] = y3
	qZ3[i] = z3
	qCol[i] = col
	qMinDetail[i] = minDetail

	cx := (x0 + x1 + x2 + x3) * 0.25
	cy := (y0 + y1 + y2 + y3) * 0.25
	cz := (z0 + z1 + z2 + z3) * 0.25
	qCX[i] = cx
	qCY[i] = cy
	qCZ[i] = cz

	var hx float32
	var hy float32
	hx = 4.0
	hy = 4.0
	hx = maxAbsDiff(cx, x0, hx)
	hx = maxAbsDiff(cx, x1, hx)
	hx = maxAbsDiff(cx, x2, hx)
	hx = maxAbsDiff(cx, x3, hx)
	hy = maxAbsDiff(cy, y0, hy)
	hy = maxAbsDiff(cy, y1, hy)
	hy = maxAbsDiff(cy, y2, hy)
	hy = maxAbsDiff(cy, y3, hy)
	qHalfX[i] = hx
	qHalfY[i] = hy

	if z2 <= 1.0 {
		qBias[i] = 40.0 - z2*12.0
		// Ground quads with Z <= 1.0 project below the bottom of the 320x216 screen when ryMax < 62.0
		qMinRY[i] = 62.0
	} else {
		qBias[i] = 0.0
		qMinRY[i] = 8.0
	}

	if x2 == x3 && y2 == y3 && z2 == z3 {
		qIsTri[i] = 1
	} else {
		qIsTri[i] = 0
	}

	quadCount = quadCount + 1
}

// Adds a 3D pine tree at (tx, ty) with a crossed 3D brown trunk and 3D pyramid canopy
func addTree3D(tx float32, ty float32, scale float32, minDetail int) {
	tw := 4.5 * scale
	th := 22.0 * scale
	r1 := 24.0 * scale
	r2 := 18.0 * scale
	z1 := 18.0 * scale
	z2 := 54.0 * scale
	z3 := 40.0 * scale
	z4 := 82.0 * scale

	// Crossed 3D trunk so it has full width from both N/S and E/W viewing angles
	addQuad(tx-tw, ty, 0.0, tx+tw, ty, 0.0, tx+tw, ty, th, tx-tw, ty, th, PAL_TIMBER, minDetail)
	addQuad(tx, ty-tw, 0.0, tx, ty+tw, 0.0, tx, ty+tw, th, tx, ty-tw, th, PAL_TIMBER, minDetail)

	// Lower 3D pyramid canopy
	addQuad(tx-r1, ty, z1, tx+r1, ty, z1, tx, ty, z2, tx, ty, z2, PAL_TREE_GREEN, minDetail)
	addQuad(tx, ty-r1, z1, tx, ty+r1, z1, tx, ty, z2, tx, ty, z2, PAL_TREE_GREEN, minDetail)

	// Upper 3D pyramid canopy
	addQuad(tx-r2, ty, z3, tx+r2, ty, z3, tx, ty, z4, tx, ty, z4, PAL_TREE_GREEN, minDetail)
	addQuad(tx, ty-r2, z3, tx, ty+r2, z3, tx, ty, z4, tx, ty, z4, PAL_TREE_GREEN, minDetail)
}

