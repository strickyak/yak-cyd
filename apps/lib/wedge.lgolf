// Top-left 12x12 exit X mark library for Lakatos OS apps.
// Core 0 intercepts any touch in the top-left 12x12 corner (0 <= x < 12, 0 <= y < 12)
// to exit the running app and return to the Home menu.
package wedge

func DrawExitWedge() {
	tft_fill_rect(0, 0, 12, 12, BLACK)
	tft_draw_line(0, 0, 11, 11, WHITE)
	tft_draw_line(11, 0, 0, 11, WHITE)
}
