// Top-left 10x10 exit wedge library for Lakatos OS apps.
// Core 0 intercepts any touch in the top-left 10x10 corner (0 <= x < 10, 0 <= y < 10)
// to exit the running app and return to the Home menu.
package wedge

func DrawExitWedge() {
	tft_fill_rect(0, 0, 10, 10, BLACK)
	for y := 0; y < 10; y++ {
		tft_draw_fast_hline(0, y, 10-y, WHITE)
	}
}
