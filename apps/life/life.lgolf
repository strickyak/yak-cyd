// Conway's Game of Life for Lakatos OS (LCode 32-bit Bytecode VM)
// Target: ESP32-2432S028R (CYD) 320x240 RGB565 Display + XPT2046 Touch
package main

const (
	COLS       = 64
	ROWS       = 42
	GRID_CELLS = 2688 // ROWS * COLS
	CELL_W     = 5
	CELL_H     = 5
	GRID_Y     = 26

	BG_DARK   = 0x0841
	BAR_BG    = 0x10A2
	BTN_HOME  = 0x2945
	BTN_RAND  = 0x03EF
	CELL_DEAD = 0x0000
	CELL_NEW  = 0x07FF // Cyan (age 1)
	CELL_MID  = 0x07E0 // Green (age 2)
	CELL_OLD  = 0xFFE0 // Yellow (age >= 3)
)

var (
	grid      [GRID_CELLS]byte
	prevGrid  [GRID_CELLS]byte
	aliveMap  [GRID_CELLS]byte
	nextAlive [GRID_CELLS]byte
	gen       int
	aliveCnt  int
)

func drawHeader() {
	tft_fill_rect(0, 0, SCREEN_W, 24, BAR_BG)
	tft_draw_fast_hline(0, 24, SCREEN_W, CYAN)

	// Standardized top-left HOME button
	tft_fill_round_rect(2, 2, 58, 20, 4, BTN_HOME)
	tft_draw_round_rect(2, 2, 58, 20, 4, CYAN)
	tft_set_text_color(CYAN, BTN_HOME)
	tft_draw_string("HOME", 15, 4, 2)

	tft_set_text_color(CYAN, BAR_BG)
	tft_draw_string("LIFE", 68, 4, 2)

	tft_set_text_color(LIGHTGREY, BAR_BG)
	tft_draw_string(os_get_airport(), 112, 4, 2)

	// Top-right RAND button
	tft_fill_round_rect(258, 2, 58, 20, 4, BTN_RAND)
	tft_draw_round_rect(258, 2, 58, 20, 4, WHITE)
	tft_set_text_color(WHITE, BTN_RAND)
	tft_draw_string("RAND", 271, 4, 2)
}

func updateStatsHUD() {
	tft_fill_rect(152, 4, 100, 16, BAR_BG)
	tft_set_text_color(YELLOW, BAR_BG)
	tft_draw_string("G:", 152, 4, 2)
	tft_draw_int(gen, 172, 4, 2)
}

func setCell(r int, c int, age byte) {
	if r < 0 {
		r += ROWS
	} else if r >= ROWS {
		r -= ROWS
	}
	if c < 0 {
		c += COLS
	} else if c >= COLS {
		c -= COLS
	}
	idx := r*COLS + c
	grid[idx] = age
	if age > 0 {
		aliveMap[idx] = 1
	} else {
		aliveMap[idx] = 0
	}
}

func spawnGlider(r int, c int) {
	setCell(r, c+1, 1)
	setCell(r+1, c+2, 1)
	setCell(r+2, c, 1)
	setCell(r+2, c+1, 1)
	setCell(r+2, c+2, 1)
}

func spawnRpentomino(r int, c int) {
	setCell(r, c+1, 1)
	setCell(r, c+2, 1)
	setCell(r+1, c, 1)
	setCell(r+1, c+1, 1)
	setCell(r+2, c+1, 1)
}

func randomizeGrid() {
	memset(&prevGrid, 255, GRID_CELLS)
	for idx := 0; idx < GRID_CELLS; idx++ {
		if os_rand(100) < 24 {
			grid[idx] = 1
			aliveMap[idx] = 1
		} else {
			grid[idx] = 0
			aliveMap[idx] = 0
		}
	}
	spawnGlider(4, 4)
	spawnRpentomino(ROWS/2, COLS/2)
	gen = 0
}

func colorForAge(age int) int {
	if age <= 0 {
		return CELL_DEAD
	}
	if age == 1 {
		return CELL_NEW
	}
	if age == 2 {
		return CELL_MID
	}
	return CELL_OLD
}

func renderGrid() {
	pGrid := int(&grid)
	pPrev := int(&prevGrid)
	for r := 0; r < ROWS; r++ {
		py := GRID_Y + r*CELL_H
		for c := 0; c < COLS; c++ {
			cur := peek1(pGrid)
			if cur != peek1(pPrev) {
				poke1(pPrev, cur)
				tft_fill_rect(c*CELL_W, py, 4, 4, colorForAge(cur))
			}
			pGrid++
			pPrev++
		}
	}
}

func stepGeneration() int {
	changed := 0
	alive := 0
	memset(&nextAlive, 0, GRID_CELLS)
	baseAlive := int(&aliveMap)
	baseGrid := int(&grid)
	baseNext := int(&nextAlive)

	for r := 0; r < ROWS; r++ {
		rm1 := r - 1
		if rm1 < 0 {
			rm1 = ROWS - 1
		}
		rp1 := r + 1
		if rp1 >= ROWS {
			rp1 = 0
		}
		rowOff := r * COLS
		pRm1 := baseAlive + rm1*COLS
		pR := baseAlive + rowOff
		pRp1 := baseAlive + rp1*COLS

		for c := 0; c < COLS; c++ {
			cm1 := (c - 1) & 63
			cp1 := (c + 1) & 63

			n := peek1(pRm1+cm1) + peek1(pRm1+c) + peek1(pRm1+cp1) +
				peek1(pR+cm1) + peek1(pR+cp1) +
				peek1(pRp1+cm1) + peek1(pRp1+c) + peek1(pRp1+cp1)

			idx := rowOff + c
			cur := peek1(baseGrid + idx)
			if cur == 0 {
				if n == 3 {
					poke1(baseGrid+idx, 1)
					poke1(baseNext+idx, 1)
					alive++
					changed++
				}
			} else {
				if n == 2 || n == 3 {
					poke1(baseNext+idx, 1)
					alive++
					if cur < 3 {
						poke1(baseGrid+idx, cur+1)
					}
				} else {
					poke1(baseGrid+idx, 0)
					changed++
				}
			}
		}
	}

	memcpy(&aliveMap, &nextAlive, GRID_CELLS)
	gen++
	aliveCnt = alive
	return changed
}

func handleTouch() bool {
	if os_serial_available() > 0 {
		ch := os_serial_read()
		if ch == 'q' || ch == 'Q' || ch == 3 {
			os_exit(0)
			return true
		}
	}
	touched, tx, ty := os_read_touch()
	if !touched {
		return false
	}
	if ty < 25 {
		if tx <= 64 {
			os_exit(0)
			return true
		}
		if tx >= 254 {
			randomizeGrid()
			renderGrid()
			updateStatsHUD()
			os_delay_ms(80)
			return false
		}
	} else if ty >= GRID_Y {
		gr := (ty - GRID_Y) / CELL_H
		gc := tx / CELL_W
		spawnRpentomino(gr-1, gc-1)
		spawnGlider(gr, gc)
		renderGrid()
	}
	return false
}

func main() {
	tft_fill_screen(BLACK)
	drawHeader()
	randomizeGrid()
	renderGrid()
	updateStatsHUD()

	stagnant := 0
	for {
		if handleTouch() {
			return
		}
		changed := stepGeneration()
		if handleTouch() {
			return
		}
		renderGrid()
		updateStatsHUD()

		if changed == 0 || aliveCnt < 12 {
			stagnant++
			if stagnant > 8 {
				randomizeGrid()
				renderGrid()
				stagnant = 0
			}
		} else {
			stagnant = 0
		}

		os_delay_ms(5)
	}
}
