	PLAY_PERIOD_MS      = 2000
	PROBE_DISPLAY_MS    = 6000
	NTP_WAIT_TIMEOUT_MS = 6000
	FRAME_DELAY_MS      = 45

	// Low-precision solar ephemeris constants (USNO / Meeus, accurate to ~0.01 deg)
	EARTH_TILT_DEG           = 23.439    // Axial obliquity of the ecliptic
	SUN_MEAN_LON_J2000_DEG   = 280.460   // Sun mean ecliptic longitude at J2000.0
	SUN_MEAN_LON_DEG_PER_DAY = 0.9856474 // 360 deg / tropical year (365.2422 d)
	SUN_MEAN_ANOM_J2000_DEG  = 357.528   // Earth mean orbital anomaly at J2000.0
	SUN_MEAN_ANOM_DEG_PER_DAY = 0.9856003 // 360 deg / anomalistic year (365.2596 d)
	EQUATION_CENTER_C1_DEG   = 1.915     // 1st eccentricity harmonic (2*e in deg)
	EQUATION_CENTER_C2_DEG   = 0.020     // 2nd eccentricity harmonic
	EOT_OBLIQUITY_C1_DEG     = 2.466     // Ecliptic-to-equator projection (tan^2(eps/2))
	EOT_OBLIQUITY_C2_DEG     = 0.053     // 2nd obliquity projection harmonic
	EARTH_ROT_DEG_PER_MIN    = 0.25      // 360 deg / 1440 min
	EARTH_ROT_MIN_PER_DEG    = 4.0       // 1440 min / 360 deg

	// Low-precision lunar ephemeris constants (Meeus, accurate to ~1 deg)
	MOON_MEAN_LON_J2000_DEG   = 218.316
	MOON_MEAN_LON_DEG_PER_DAY = 13.176396
	MOON_MEAN_ANOM_J2000_DEG  = 134.963
	MOON_MEAN_ANOM_DEG_PER_DAY = 13.064993
	MOON_ARG_LAT_J2000_DEG    = 93.272
	MOON_ARG_LAT_DEG_PER_DAY  = 13.229350
	MOON_ECLIPTIC_C1_DEG      = 6.289    // Equation of center for lunar orbit
	MOON_LAT_AMP_DEG          = 5.128    // 5.1 deg orbital inclination to ecliptic
	MOON_MAX_BOOST_LEVELS     = 8        // Max brightness lift (0..8, < CITY_GLOW_END_LEVEL) on moonlit night side

	// Map projection & city indicator thresholds
	MAP_LON_MIN_DEG         = -180.0
	MAP_LON_MAX_DEG         = 180.0
	MAP_LON_SPAN_DEG        = 360.0
	MAP_LAT_MAX_DEG         = 80.0
	AIRPORT_MAX_VALID_LAT   = 85.0
	AIRPORT_MIN_VALID_DEG   = 0.01
	AP_INFO_BUF_SIZE        = 72
	AP_INFO_LAT_OFFSET      = 60
	AP_INFO_LON_OFFSET      = 64
	LOCAL_TIME_BUF_SIZE     = 32
	LOCAL_TIME_FMT_MAX      = 24
	HMS_HOUR_OFFSET         = 0
	HMS_MIN_OFFSET          = 3
	HMS_SEC_OFFSET          = 6
	SOLAR_DAY_SIN_ALT       = 0.02       // Sun > ~1.1 deg above horizon
	SOLAR_TWILIGHT_SIN_ALT  = -0.10      // Civil/nautical dusk boundary (~-6 deg)

	// Header & control bar geometry (single source of truth for drawing & hit-testing)
