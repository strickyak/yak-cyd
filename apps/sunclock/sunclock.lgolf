	// Clocks, cities & interaction timings
	MIN_VALID_UNIX_SEC  = 1700000000
	FALLBACK_UNIX_SEC   = 1795325160
	J2000_UNIX_SEC      = 946728000 // 2000-01-01 12:00:00 UTC
	MS_PER_SEC          = 1000
	SECS_PER_MINUTE     = 60
