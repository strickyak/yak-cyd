// ============================================================================
// World Sun Clock (Geochron Day/Night Terminator) for Lakatos OS
// Target: ESP32-2432S028R (CYD) 320x240 RGB565 Display + XPT2046 Touch
//
// Architecture & Conventions ("Apps Hungarian"):
//   - *Deg / *Rad : Geographic angles in degrees (-180..+180, -80..+80) or radians
//   - *Q10        : Fixed-point integers scaled by 1024 (1 << 10) for fast inner loops
//   - screenX/Y   : Physical 320x240 display pixel coordinates
//   - mapRow/Col  : Map coordinates (160 rows x 160 double-pixel columns)
//   - *Sec/*Min/*Ms: Time values in seconds, minutes, or milliseconds
//   - *Swapped565 : Byte-swapped RGB565 words required by tft_push_rgb565 DMA
// ============================================================================
package main

import "wedge"

// ----------------------------------------------------------------------------
// 1. Layout, Timing, Astronomy & Biome Constants
// ----------------------------------------------------------------------------

