	CITY_ARROW_W        = 20
	CITY_CARD_W         = 70
	CITY_DOT_OFFSET_X   = 7
	CITY_DOT_OFFSET_Y   = 13
	CITY_DOT_RADIUS     = 3
	CITY_TEXT_OFFSET_X  = 14
